# ============================================
# PDF Tools Platform - Environment Configuration
# ============================================

# --- General ---
NODE_ENV=production
LOG_LEVEL=info

# --- Gateway ---
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0

# --- Stirling PDF ---
STIRLING_URL=http://stirling:8080
STIRLING_TIMEOUT_MS=120000

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password

# --- File Storage ---
STORAGE_TYPE=local
STORAGE_BASE_PATH=/tmp/pdf-tools-storage
FILE_RETENTION_MINUTES=30
MAX_FILE_SIZE_MB=100
CLEANUP_INTERVAL_MS=60000

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Security ---
CORS_ORIGIN=*
REQUEST_TIMEOUT_MS=120000

# --- Future: S3-Compatible Storage ---
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=pdf-tools
# S3_REGION=us-east-1

# --- Future: Worker Service ---
# WORKER_URL=http://compression-worker:4000
# WORKER_ENABLED=false

# --- Future: Authentication ---
# AUTH_ENABLED=false
# JWT_SECRET=changeme_jwt_secret
# JWT_EXPIRY=3600
